NODE_ENV=production
PORT=5000
API_VERSION=v1

CLIENT_URL=https://synapsehire.example.com
CORS_ORIGINS=https://synapsehire.example.com

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/synapsehire?retryWrites=true&w=majority
MONGODB_MAX_POOL_SIZE=50

REDIS_URL=rediss://default:PASSWORD@redis-cloud.example.com:6379
REDIS_KEY_PREFIX=synapsehire:

JWT_ACCESS_SECRET=replace-with-64-byte-random-secret
JWT_REFRESH_SECRET=replace-with-different-64-byte-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_COOKIE_NAME=synapsehire_refresh
JWT_ISSUER=synapsehire-api
JWT_AUDIENCE=synapsehire-web

GOOGLE_CLIENT_ID=

BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

LOG_LEVEL=info

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SynapseHire <no-reply@synapsehire.example.com>"

UPLOAD_MAX_FILE_SIZE_MB=10
RECORDING_MAX_CHUNK_MB=25
RECORDING_STORAGE_PATH=uploads/recordings

EMAIL_VERIFICATION_TTL_MINUTES=30
PASSWORD_RESET_TTL_MINUTES=15
OTP_TTL_MINUTES=10

CODE_RUNNER_URL=
CODE_RUNNER_TIMEOUT_MS=10000

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
