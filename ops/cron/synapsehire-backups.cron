SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# Nightly MongoDB logical backup. MONGODB_URI should be injected via /etc/synapsehire-backup.env.
15 2 * * * source /etc/synapsehire-backup.env && cd /opt/synapsehire && BACKUP_DIR=/var/backups/synapsehire/mongodb RETENTION_DAYS=14 bash ops/scripts/backup-mongodb-atlas.sh >> /var/log/synapsehire-backup.log 2>&1

# Renew certificates twice daily and reload Nginx when renewed.
0 3,15 * * * cd /opt/synapsehire && docker run --rm -v "$(pwd)/ops/certbot/conf:/etc/letsencrypt" -v "$(pwd)/ops/certbot/www:/var/www/certbot" certbot/certbot renew --webroot --webroot-path=/var/www/certbot && docker compose -f docker-compose.prod.yml exec nginx nginx -s reload >> /var/log/synapsehire-certbot.log 2>&1
